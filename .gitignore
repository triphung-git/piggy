# ============================================================
# TFT Post-Match Studio — .gitignore (Open Source Edition)
# ============================================================

# === THÔNG TIN CÁ NHÂN & BẢO MẬT — KHÔNG BAO GIỜ COMMIT ===
.env
*.env.local

# === Python ===
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
*.spec.bak
.venv/
venv/
env/

# === Node.js / Frontend ===
node_modules/
Web Overlay/dist/
web/dist/
Web Overlay/.cache/
web/.cache/

# === Output & Cache (dữ liệu người dùng) ===
output/
scratch/
sbom/
*.log

# === Assets cá nhân ===
assets/avatars/
!assets/avatars/.gitkeep

# === PyInstaller Build Artifacts ===
dist_setup/
*.exe
installer.iss.bak

# === IDE ===
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
# === Testing & Coverage ===
.coverage
.coverage.*
htmlcov/
.pytest_cache/
.ruff_cache/
